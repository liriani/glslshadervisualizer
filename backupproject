const App = () => {
  const [activeShader, setActiveShader] = useState(SHADER_TEMPLATES[0]);
  const [shaderCode, setShaderCode] = useState(SHADER_TEMPLATES[0].code);
  const [error, setError] = useState(null);
  const [copied, setCopied] = useState(false);
  const containerRef = useRef(null);
  const rendererRef = useRef(null);
  const uniformsRef = useRef({
    uTime: { value: 0 },
    uRes: { value: new THREE.Vector2() }
  });

  useEffect(() => {
    if (!containerRef.current) return;

    // Scene Setup
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    rendererRef.current = renderer;

    const updateSize = () => {
      const width = containerRef.current.clientWidth;
      const height = containerRef.current.clientHeight;
      renderer.setSize(width, height);
      uniformsRef.current.uRes.value.set(width, height);
    };

    containerRef.current.appendChild(renderer.domElement);
    updateSize();

    // Geometry
    const geometry = new THREE.PlaneGeometry(2, 2);
    let material;

    try {
      material = new THREE.ShaderMaterial({
        uniforms: uniformsRef.current,
        vertexShader: `
          void main() {
            gl_Position = vec4(position, 1.0);
          }
        `,
        fragmentShader: shaderCode.replace('out vec4 fragColor;', '').replace('fragColor =', 'gl_FragColor ='),
      });
    } catch (e) {
      setError(e.message);
    }

    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let animationFrame;
    const animate = (time) => {
      uniformsRef.current.uTime.value = time / 1000;
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(animate);
    };
    animate();

    const handleResize = () => updateSize();
    window.addEventListener('resize', handleResize);

    return () => {
      window.removeEventListener('resize', handleResize);
      cancelAnimationFrame(animationFrame);
      if (containerRef.current && renderer.domElement) {
        containerRef.current.removeChild(renderer.domElement);
      }
      geometry.dispose();
      if (material) material.dispose();
    };
  }, [shaderCode]);

  const handleCopy = () => {
    document.execCommand('copy');
    const tempInput = document.createElement('textarea');
    tempInput.value = shaderCode;
    document.body.appendChild(tempInput);
    tempInput.select();
    document.execCommand('copy');
    document.body.removeChild(tempInput);

    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const selectTemplate = (template) => {
    setActiveShader(template);
    setShaderCode(template.code);
    setError(null);
  };

  return (
    <div className="flex flex-col h-screen bg-[#0a0a0a] text-slate-200 font-sans">
      {/* Header */}
      <header className="h-16 border-b border-white/10 flex items-center justify-between px-6 bg-[#0f0f0f]">
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center shadow-[0_0_15px_rgba(16,185,129,0.4)]">
            <Layers size={18} className="text-black" />
          </div>
          <div>
            <h1 className="font-bold tracking-tight text-lg">GLSL Visualizer <span className="text-emerald-500 text-xs font-mono ml-2 px-1.5 py-0.5 border border-emerald-500/30 rounded">TD Ready</span></h1>
          </div>
        </div>

        <div className="flex items-center gap-4">
          <button
            onClick={handleCopy}
            className="flex items-center gap-2 px-4 py-2 bg-emerald-600 hover:bg-emerald-500 transition-colors rounded-md text-sm font-medium text-white shadow-lg"
          >
            {copied ? <CheckCircle2 size={16} /> : <Copy size={16} />}
            {copied ? 'Copied!' : 'Copy Code for TOP'}
          </button>
        </div>
      </header>

      <main className="flex-1 flex overflow-hidden">
        {/* Sidebar */}
        <aside className="w-80 border-r border-white/10 bg-[#0f0f0f] flex flex-col z-10">
          <div className="p-4 border-b border-white/5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500 bg-[#0f0f0f]">
            <BookOpen size={14} />
            Library ({SHADER_TEMPLATES.length})
          </div>
          <div className="flex-1 overflow-y-auto p-3 space-y-2 custom-scrollbar">
            {SHADER_TEMPLATES.map((t) => (
              <button
                key={t.id}
                onClick={() => selectTemplate(t)}
                className={`w-full text-left p-4 rounded-xl transition-all border ${
                  activeShader.id === t.id
                    ? 'bg-emerald-500/10 border-emerald-500/40 shadow-[0_0_20px_rgba(16,185,129,0.05)]'
                    : 'bg-white/5 border-transparent hover:bg-white/10'
                }`}
              >
                <div className={`font-semibold mb-1 ${activeShader.id === t.id ? 'text-emerald-400' : 'text-slate-200'}`}>
                  {t.name}
                </div>
                <div className="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {t.description}
                </div>
              </button>
            ))}
          </div>

          <div className="p-4 bg-emerald-500/5 border-t border-emerald-500/20">
            <div className="text-[10px] uppercase font-bold text-emerald-500 mb-2">Pro Tip</div>
            <p className="text-xs text-slate-400 leading-relaxed">
              In TouchDesigner, replace <code className="text-emerald-400">uTime</code> with <code className="text-white">absTime.seconds</code> for continuous loopless animation.
            </p>
          </div>
        </aside>

        {/* Workspace */}
        <div className="flex-1 flex flex-col md:flex-row">
          {/* Editor Section */}
          <div className="flex-1 flex flex-col border-r border-white/10 max-w-[50%]">
            <div className="h-10 px-4 flex items-center justify-between bg-black/40 border-b border-white/5">
              <div className="flex items-center gap-2 text-xs font-medium text-slate-400">
                <Code size={14} /> glsl_shader.frag
              </div>
            </div>
            <textarea
              value={shaderCode}
              onChange={(e) => setShaderCode(e.target.value)}
              spellCheck="false"
              className="flex-1 w-full bg-transparent p-6 font-mono text-sm resize-none focus:outline-none text-emerald-100/90 leading-6 selection:bg-emerald-500/30 custom-scrollbar"
            />
          </div>

          {/* Preview Section */}
          <div className="flex-1 flex flex-col bg-black">
             <div className="h-10 px-4 flex items-center justify-between bg-black/40 border-b border-white/5">
              <div className="flex items-center gap-2 text-xs font-medium text-slate-400">
                <Play size={14} /> Live Preview
              </div>
              <div className="flex items-center gap-3">
                <Monitor size={14} className="text-slate-500" />
                <span className="text-[10px] text-slate-500 font-mono">Simulated Environment</span>
              </div>
            </div>

            <div ref={containerRef} className="flex-1 relative overflow-hidden group">
              {error && (
                <div className="absolute inset-x-0 top-0 p-4 bg-red-500/20 backdrop-blur-md border-b border-red-500/40 text-red-400 text-xs font-mono z-10 whitespace-pre-wrap">
                  {error}
                </div>
              )}
              <div className="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
                <button className="p-2 bg-black/50 hover:bg-black/80 rounded-full text-slate-400 border border-white/10">
                  <Maximize2 size={16} />
                </button>
              </div>
            </div>

            {/* Control Panel */}
            <div className="h-24 bg-[#0f0f0f] border-t border-white/10 p-4 flex items-center gap-6">
              <div className="flex-1">
                <div className="flex justify-between text-[10px] text-slate-500 mb-2 uppercase font-bold tracking-widest">
                  <span>Uniform: uTime</span>
                  <span className="text-emerald-500 font-mono">{uniformsRef.current.uTime.value.toFixed(2)}s</span>
                </div>
                <div className="h-1 bg-white/5 rounded-full overflow-hidden">
                  <div
                    className="h-full bg-emerald-500 transition-all duration-75"
                    style={{ width: `${(uniformsRef.current.uTime.value % 10) * 10}%` }}
                  />
                </div>
              </div>

              <div className="flex gap-2">
                <button className="w-10 h-10 rounded-lg border border-white/10 flex items-center justify-center hover:bg-white/5 transition-colors">
                  <Settings size={18} className="text-slate-400" />
                </button>
                <button className="w-10 h-10 rounded-lg border border-white/10 flex items-center justify-center hover:bg-white/5 transition-colors">
                  <Download size={18} className="text-slate-400" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </main>

      {/* Scrollbar styling injected globally for a cleaner look */}
      <style dangerouslySetInnerHTML={{__html: `
        .custom-scrollbar::-webkit-scrollbar {
          width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: rgba(255, 255, 255, 0.1);
          border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
          background: rgba(255, 255, 255, 0.2);
        }
      `}} />
    </div>
  );
};

export default App;